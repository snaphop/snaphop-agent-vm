#cloud-config
# Generated by agent-vm {{ .AgentVMVersion }}. Do not edit: this file is
# regenerated from the VM's configuration and is kept only as a record of what
# the guest was configured with.
#
# This is the whole guest-side contract. It authorizes public keys and creates
# the login user and the groups that let it reach the Docker socket and libvirt
# and install Rust toolchains. It installs no packages and carries no
# credentials. It writes a git identity for this VM: user.name is the VM name
# and user.email is that name at the configured domain. A bridged guest also
# publishes its hostname and SSH with mDNS. A NAT guest does not.
# A base image is shared by every VM built on it, so anything per-VM has to
# arrive here, and anything secret must not arrive at all (SECURITY.md).

# Only agent-vm's own settings may name the host; a stale hostname from the
# image would make two VMs indistinguishable in logs.
hostname: {{ .Hostname | yaml }}
preserve_hostname: false

# Docker's socket is owned by root:docker, and libvirt's by root:libvirt, so
# the login user has to be in those groups to run `docker` and `virsh` without
# sudo; kvm is what lets the VMs it starts use /dev/kvm. A full image makes the
# shared /usr/local/rustup writable by the rustup group, so the login user can
# install the toolchain a project's rust-toolchain.toml pins. They are declared
# here rather than only in the base image's boot-time unit because a group added
# to an account after it has already logged in does not apply to that session,
# and the first SSH session can land before a post-cloud-init unit has run.
#
# Declaring the groups is what keeps this safe on a base image that has none of
# that software — one built before the guest tooling landed, or a slim, nix or
# runner image, which has no rustup group. cloud-init creates groups before
# users, so the account is created either way; without this, a missing group
# would fail user creation and leave the VM unreachable (AGENTS.md §8).
groups:
  - docker
  - libvirt
  - kvm
  - rustup

users:
  - name: {{ .User | yaml }}
    groups:
      - docker
      - libvirt
      - kvm
      - rustup
    # No password is ever set, so the account is reachable by key only. sudo is
    # granted through a sudoers drop-in rather than by adding the user to a
    # group, because the group that confers sudo differs per distro and this
    # file must mean the same thing on all of them.
    lock_passwd: true
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    shell: /bin/bash
    ssh_authorized_keys:
{{- range .SSHAuthorizedKeys }}
      - {{ . | yaml }}
{{- end }}

# Passwords are never accepted: the only way in is a key listed above.
ssh_pwauth: false
disable_root: true
{{- if .HasSwap }}

# Swap file on the root filesystem. cloud-init's mounts module creates it
# once, after the root partition has grown to the virtual disk, marks it
# mode 600, and records it in /etc/fstab so later boots activate it. The
# size is a whole number of mebibytes. That module already runs in every
# base image, so a cached image does not need a rebuild (ADR-0025).
swap:
  filename: /swapfile
  size: "{{ .Swap }}"
{{- end }}
{{- if and .PublishMDNS (not .HasExtraUserData) }}

# This guest is on a bridge. Publish the VM name and SSH with mDNS so other
# machines on the LAN can open it as <user>@<name>.local (ADR-0020). The base
# image already runs systemd-resolved. The hostname is set before resolved is
# restarted, because %H is expanded when resolved loads the service file, and
# resolved is restarted only when that configuration changed.
# The name below is a validated VM name: lowercase letters, digits, and hyphens.
bootcmd:
  - |
{{ indent 4 .MDNSScript }}
{{- end }}
{{ if not .HasExtraUserData }}
# Git identity for this VM. user.name is the VM name and user.email is
# <name>@<domain>. /etc/gitconfig applies to every account, including one the
# image created before first boot. /etc/skel is what the login user inherits,
# because cloud-init runs write_files before it creates users, and /root
# already exists, so it needs its own file (ADR-0026).
write_files:
{{ .GitconfigFiles }}
{{ if .HasOpencodeConfig }}
  # The operator's own opencode.json, from `create --opencode-config`. The base
  # image ships one in /etc/skel and /root; this replaces both, per VM, without
  # rebuilding the image. The content is base64 so that a JSON document cannot
  # be reshaped by YAML quoting on its way through this file.
  - path: /etc/skel/.config/opencode/opencode.json
    encoding: b64
    content: {{ .OpencodeConfigBase64 }}
    owner: "root:root"
    permissions: "0644"
  - path: /root/.config/opencode/opencode.json
    encoding: b64
    content: {{ .OpencodeConfigBase64 }}
    owner: "root:root"
    permissions: "0644"
{{ end }}
{{ end -}}
{{ if .HasExtraUserData }}
# This part is applied after the operator's own user-data, and these merge
# rules make that ordering mean something: their lists are added to ours, and
# where both set the same key, the settings above win. Without an explicit rule
# here, whether an operator could replace the authorized keys would depend on
# cloud-init's default merger. The git identity is a later part, so an operator
# write_files list is kept and the .gitconfig entries are appended to it.
merge_how: "dict(recurse_array,replace)+list(append)"
{{ end -}}
{{ if and .HasExtraUserData .HasOpencodeConfig }}
# The operator's own opencode.json, from `create --opencode-config`. The base
# image ships one in /etc/skel and /root; this replaces both, per VM, without
# rebuilding the image.
#
# It is written into /etc/skel rather than into the login user's home because
# cloud-init runs write_files before it creates users, so skel is what the new
# account inherits — and /root already exists here, which is why it needs its
# own entry. The content is base64 so that a JSON document cannot be reshaped
# by YAML quoting on its way through this file.
write_files:
  - path: /etc/skel/.config/opencode/opencode.json
    encoding: b64
    content: {{ .OpencodeConfigBase64 }}
    owner: "root:root"
    permissions: "0644"
  - path: /root/.config/opencode/opencode.json
    encoding: b64
    content: {{ .OpencodeConfigBase64 }}
    owner: "root:root"
    permissions: "0644"
{{ end -}}
