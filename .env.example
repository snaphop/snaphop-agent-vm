# snaphop-agent-vm — local overrides, as a development convenience.
#
# agent-vm does NOT read this file. It reads the process environment, so source
# it into your shell (`set -a; . ./.env; set +a`) or use the config file at
# ~/.config/agent-vm/config.toml, which is the supported persistent mechanism.
#
# Copy to .env and edit. Every value here is optional; the defaults in
# docs/cli.md apply when a variable is unset. Never put secrets in this file —
# this tool needs none, and .env is gitignored precisely so a mistake stays local.

# Where base images and per-VM state live.
# AGENT_VM_STATE_DIR=~/.local/share/agent-vm

# libvirt connection. qemu:///system is required for bridged networking;
# qemu:///session is unprivileged and NAT-only.
# AGENT_VM_LIBVIRT_URI=qemu:///system

# Path to the configuration file.
# AGENT_VM_CONFIG=~/.config/agent-vm/config.toml

# A directory holding a general-purpose kernel for libguestfs to build its
# appliance from, named after that kernel's version. Only needed on a host whose
# own kernel cannot boot the appliance — `agent-vm doctor` says so if yours
# cannot. See docs/host-setup.md.
# AGENT_VM_APPLIANCE_KERNEL=~/.local/share/agent-vm/appliance-kernel/6.12.4-arch1-1

# Defaults for `agent-vm create`.
# AGENT_VM_DISTRO=ubuntu
# AGENT_VM_VCPUS=2
# AGENT_VM_MEMORY=4G
# Ceiling the guest's RAM can be grown to at runtime, via a virtio-mem device.
# Unset means a fixed-size guest.
# AGENT_VM_MAX_MEMORY=16G
# AGENT_VM_DISK=50G

# Network mode: nat (default) or bridge. Bridged mode puts the guest on your LAN.
# AGENT_VM_NETWORK=nat
# AGENT_VM_BRIDGE=br0

# SSH *public* key authorized in the guest. Never point this at a private key.
# AGENT_VM_SSH_KEY=~/.ssh/id_ed25519.pub
