MIME-Version: 1.0
Content-Type: multipart/mixed; boundary="agent-vm-cloud-init"

--agent-vm-cloud-init
Content-Disposition: attachment; filename="user-supplied"
Content-Type: text/cloud-config; charset="utf-8"

#cloud-config
bootcmd:
  - echo operator-boot
packages:
  - ripgrep

--agent-vm-cloud-init
Content-Disposition: attachment; filename="agent-vm"
Content-Type: text/cloud-config; charset="utf-8"

#cloud-config
# Generated by agent-vm 0.1.0-test. Do not edit: this file is
# regenerated from the VM's configuration and is kept only as a record of what
# the guest was configured with.
#
# This is the whole guest-side contract. It authorizes public keys and creates
# the login user and the groups that let it reach the Docker socket and libvirt
# and install Rust toolchains. It installs no packages and carries no
# credentials. It writes a git identity for this VM: user.name is the VM name
# and user.email is that name at the configured domain. A bridged guest also
# publishes its hostname and SSH with mDNS. A NAT guest does not.
# A base image is shared by every VM built on it, so anything per-VM has to
# arrive here, and anything secret must not arrive at all (SECURITY.md).

# Only agent-vm's own settings may name the host; a stale hostname from the
# image would make two VMs indistinguishable in logs.
hostname: "agent-01"
preserve_hostname: false

# Docker's socket is owned by root:docker, and libvirt's by root:libvirt, so
# the login user has to be in those groups to run `docker` and `virsh` without
# sudo; kvm is what lets the VMs it starts use /dev/kvm. A full image makes the
# shared /usr/local/rustup writable by the rustup group, so the login user can
# install the toolchain a project's rust-toolchain.toml pins. They are declared
# here rather than only in the base image's boot-time unit because a group added
# to an account after it has already logged in does not apply to that session,
# and the first SSH session can land before a post-cloud-init unit has run.
#
# Declaring the groups is what keeps this safe on a base image that has none of
# that software — one built before the guest tooling landed, or a slim, nix or
# runner image, which has no rustup group. cloud-init creates groups before
# users, so the account is created either way; without this, a missing group
# would fail user creation and leave the VM unreachable (AGENTS.md §8).
groups:
  - docker
  - libvirt
  - kvm
  - rustup

users:
  - name: "agent"
    groups:
      - docker
      - libvirt
      - kvm
      - rustup
    # No password is ever set, so the account is reachable by key only. sudo is
    # granted through a sudoers drop-in rather than by adding the user to a
    # group, because the group that confers sudo differs per distro and this
    # file must mean the same thing on all of them.
    lock_passwd: true
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    shell: /bin/bash
    ssh_authorized_keys:
      - "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIJ1TfEt0YKXQ+eZmJHCcTKQ0lMSzQFm/kQGHMvhE7Hqx agent@example"

# Passwords are never accepted: the only way in is a key listed above.
ssh_pwauth: false
disable_root: true

# This part is applied after the operator's own user-data, and these merge
# rules make that ordering mean something: their lists are added to ours, and
# where both set the same key, the settings above win. Without an explicit rule
# here, whether an operator could replace the authorized keys would depend on
# cloud-init's default merger. The git identity is a later part, so an operator
# write_files list is kept and the .gitconfig entries are appended to it.
merge_how: "dict(recurse_array,replace)+list(append)"

--agent-vm-cloud-init
Content-Disposition: attachment; filename="agent-vm-mdns"
Content-Type: text/cloud-config; charset="utf-8"

#cloud-config
# Applied after the settings part. That part replaces every list it names, so
# this publication is its own part: list(append) keeps an operator bootcmd and
# runs it before the script below (ADR-0020).
merge_how: "dict(recurse_array)+list(append)"
bootcmd:
  - |
    #!/bin/sh
    # Publish SSH on this guest's ethernet interfaces with mDNS.
    # cloud-init runs this on every boot, after the network is up and before SSH.
    set -eu
    name='agent-01'
    printf '%s\n' "$name" > /etc/hostname
    if command -v hostnamectl >/dev/null 2>&1; then
      hostnamectl set-hostname "$name" || true
    fi
    if command -v hostname >/dev/null 2>&1; then
      hostname "$name" || true
    fi
    mkdir -p /etc/systemd/resolved.conf.d /etc/systemd/dnssd
    write_if_changed() {
      dest=$1
      mkdir -p "$(dirname "$dest")"
      tmp=${dest}.tmp
      cat > "$tmp"
      if [ -f "$dest" ] && [ "$(cat "$dest")" = "$(cat "$tmp")" ]; then
        rm -f "$tmp"
        return 1
      fi
      mv "$tmp" "$dest"
      return 0
    }
    changed=0
    if write_if_changed /etc/systemd/resolved.conf.d/10-agent-vm-mdns.conf <<'EOF'
    [Resolve]
    MulticastDNS=yes
    EOF
    then
      changed=1
    fi
    if write_if_changed /etc/systemd/dnssd/ssh.dnssd <<'EOF'
    [Service]
    Name=%H
    Type=_ssh._tcp
    Port=22
    EOF
    then
      changed=1
    fi
    if [ "$changed" -eq 1 ] && systemctl is-active --quiet systemd-resolved; then
      systemctl restart systemd-resolved
    fi
    n=0
    for path in /sys/class/net/en* /sys/class/net/eth*; do
      [ -e "$path" ] || continue
      resolvectl mdns "${path##*/}" yes
      n=$((n + 1))
    done
    [ "$n" -gt 0 ]


--agent-vm-cloud-init
Content-Disposition: attachment; filename="agent-vm-gitconfig"
Content-Type: text/cloud-config; charset="utf-8"

#cloud-config
# Applied after the settings part. That part replaces every list it names, so
# these files are their own part: list(append) keeps an operator write_files
# and still installs this VM's git identity (ADR-0026).
merge_how: "dict(recurse_array)+list(append)"
write_files:
  - path: /etc/gitconfig
    content: |
      [user]
          name = agent-01
          email = agent-01@local
    owner: "root:root"
    permissions: "0644"
  - path: /etc/skel/.gitconfig
    content: |
      [user]
          name = agent-01
          email = agent-01@local
    owner: "root:root"
    permissions: "0644"
  - path: /root/.gitconfig
    content: |
      [user]
          name = agent-01
          email = agent-01@local
    owner: "root:root"
    permissions: "0644"


--agent-vm-cloud-init--
