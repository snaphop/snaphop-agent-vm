MIME-Version: 1.0
Content-Type: multipart/mixed; boundary="agent-vm-cloud-init"

--agent-vm-cloud-init
Content-Disposition: attachment; filename="user-supplied"
Content-Type: text/cloud-config; charset="utf-8"

#cloud-config
packages:
  - ripgrep

--agent-vm-cloud-init
Content-Disposition: attachment; filename="agent-vm"
Content-Type: text/cloud-config; charset="utf-8"

#cloud-config
# Generated by agent-vm 0.1.0-test. Do not edit: this file is
# regenerated from the VM's configuration and is kept only as a record of what
# the guest was configured with.
#
# This is the whole guest-side contract. It authorizes public keys, creates the
# login user and the groups that let it reach the Docker socket and libvirt,
# and does nothing else — no packages, no commands, no credentials.
# A base image is shared by every VM built on it, so anything per-VM has to
# arrive here, and anything secret must not arrive at all (SECURITY.md).

# Only agent-vm's own settings may name the host; a stale hostname from the
# image would make two VMs indistinguishable in logs.
hostname: "agent-01"
preserve_hostname: false

# Docker's socket is owned by root:docker, and libvirt's by root:libvirt, so
# the login user has to be in those groups to run `docker` and `virsh` without
# sudo; kvm is what lets the VMs it starts use /dev/kvm. They are declared here
# rather than only in the base image's boot-time unit because a group added to
# an account after it has already logged in does not apply to that session, and
# the first SSH session can land before a post-cloud-init unit has run.
#
# Declaring the groups is what keeps this safe on a base image that has none of
# that software — one built before the guest tooling landed. cloud-init creates
# groups before users, so the account is created either way; without this, a
# missing group would fail user creation and leave the VM unreachable
# (AGENTS.md §8).
groups:
  - docker
  - libvirt
  - kvm

users:
  - name: "agent"
    groups:
      - docker
      - libvirt
      - kvm
    # No password is ever set, so the account is reachable by key only. sudo is
    # granted through a sudoers drop-in rather than by adding the user to a
    # group, because the group that confers sudo differs per distro and this
    # file must mean the same thing on all of them.
    lock_passwd: true
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    shell: /bin/bash
    ssh_authorized_keys:
      - "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIJ1TfEt0YKXQ+eZmJHCcTKQ0lMSzQFm/kQGHMvhE7Hqx agent@example"

# Passwords are never accepted: the only way in is a key listed above.
ssh_pwauth: false
disable_root: true

# This part is applied after the operator's own user-data, and these merge
# rules make that ordering mean something: their lists are added to ours, and
# where both set the same key, the settings above win. Without an explicit rule
# here, whether an operator could replace the authorized keys would depend on
# cloud-init's default merger.
merge_how: "dict(recurse_array,replace)+list(append)"

--agent-vm-cloud-init--
